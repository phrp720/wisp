{
  "$schema": "https://willowisp.dev/schema.json",
  "name": "Wisp",
  "icon": "🔮",
  "color": "#6d4aff",
  "notes": "Wisp's own workspace file: the tool, used to build itself.",

  "pipelines": [
    {
      "label": "Work on the CLI",
      "color": "#a78bfa",
      "steps": [
        { "folder": "cli/src" },
        { "run": "pnpm --filter @phrp720/wisp test:watch", "label": "tests (watch)" },
        { "run": "pnpm --filter @phrp720/wisp exec tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput", "label": "typecheck (watch)" }
      ]
    },
    {
      "label": "Work on the website",
      "color": "#f472b6",
      "steps": [
        { "run": "pnpm --filter wisp-website install && pnpm --filter wisp-website dev", "label": "website" },
        { "wait": "http://localhost:5173", "label": "up", "after": "website" },
        { "url": "http://localhost:5173", "label": "Website", "after": "up" }
      ]
    },
    {
      "label": "Check everything",
      "color": "#34d399",
      "steps": [
        { "run": "pnpm typecheck", "label": "typecheck", "finishes": true },
        { "run": "pnpm test", "label": "test", "finishes": true },
        { "run": "pnpm build", "label": "build", "after": ["typecheck", "test"], "finishes": true },
        { "run": "pnpm website:build", "label": "website build", "after": "build", "finishes": true }
      ]
    },
    {
      "label": "Try my build",
      "color": "#60a5fa",
      "steps": [
        { "pipeline": "Make wisp-dev", "label": "make" },
        { "run": "node scripts/bundle.mjs --watch", "cwd": "cli", "label": "rebuild wisp-dev as you edit", "after": "make" }
      ],
      "down": [{ "run": "rm -f \"$HOME/.local/bin/wisp-dev\"", "label": "remove wisp-dev" }]
    },
    {
      "label": "Make wisp-dev",
      "color": "#93c5fd",
      "steps": [
        { "run": "pnpm build", "label": "build the CLI", "finishes": true },
        { "run": "mkdir -p \"$HOME/.local/bin\" && ln -sf \"$PWD/cli/dist/bin/wisp.js\" \"$HOME/.local/bin/wisp-dev\"", "label": "link wisp-dev to the build", "after": "build the CLI", "finishes": true },
        { "run": "\"$HOME/.local/bin/wisp-dev\" --version", "label": "check wisp-dev runs", "after": "link wisp-dev to the build", "finishes": true }
      ]
    },
    {
      "label": "Compile the binary",
      "color": "#facc15",
      "steps": [
        { "run": "pnpm compile", "label": "compile", "finishes": true },
        { "run": "./bin/wisp --version", "cwd": "cli", "label": "it runs", "after": "compile", "finishes": true }
      ]
    },
    {
      "label": "Update the agent reference",
      "color": "#2dd4bf",
      "steps": [
        { "run": "pnpm spec", "label": "write docs/SPEC.md", "finishes": true }
      ]
    },
    {
      "label": "Bump the version",
      "color": "#f97316",
      "inputs": { "version": { "ask": "New version? (like 0.1.1 for fixes, 0.2.0 for features)" } },
      "steps": [
        { "run": "node cli/scripts/version.mjs {{version}}", "label": "set the version", "finishes": true },
        { "run": "pnpm --filter @phrp720/wisp exec vitest run tests/cli/cli.test.ts -t version", "label": "check both match", "after": "set the version", "finishes": true }
      ]
    },
    {
      "label": "Documentation",
      "color": "#94a3b8",
      "steps": [
        { "url": "https://willowisp.dev/docs", "label": "Documentation" }
      ]
    },
    {
      "label": "Open the project pages",
      "color": "#38bdf8",
      "steps": [
        { "url": "https://github.com/phrp720/wisp", "label": "Repository" },
        { "url": "https://willowisp.dev", "label": "Live website" },
        { "url": "https://www.npmjs.com/package/@phrp720/wisp", "label": "npm package" }
      ]
    }
  ]
}
