{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phrp720/wisp/main/schema/wisp.schema.json",
  "title": "Wisp workspace file",
  "description": "A .wisp.json: the bolts that start a project's working context (its links, folders, files, apps and commands) with one word. Committed next to the code, so the repository carries its own context.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, so your editor can autocomplete and validate it."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "What this project is called. Optional: a file that does not name itself is named after its directory.",
      "examples": [
        "Acme",
        "Platform"
      ]
    },
    "icon": {
      "type": "string",
      "description": "An emoji shown beside the name.",
      "examples": [
        "🏢",
        "🔮"
      ]
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "notes": {
      "type": "string",
      "description": "A line about what this project is for."
    },
    "bolts": {
      "type": "array",
      "description": "What you run: 'Work on api', 'Incident response'. A bolt lists what to start, in order: inline, or by naming a shared asset.",
      "items": {
        "$ref": "#/$defs/bolt"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "description": "Hex colour.",
      "examples": [
        "#6d4aff"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "How a bolt names this, and what is shown for it. Unique within its kind."
    },
    "osName": {
      "type": "string",
      "enum": [
        "macos",
        "linux",
        "windows",
        "darwin",
        "win32",
        "mac",
        "osx",
        "win"
      ]
    },
    "os": {
      "description": "Only on these operating systems. Elsewhere it is skipped, quietly.",
      "oneOf": [
        {
          "$ref": "#/$defs/osName"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/osName"
          },
          "minItems": 1
        }
      ]
    },
    "perOS": {
      "type": "object",
      "description": "A different value per operating system. An OS left out does not have this.",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^(macos|linux|windows|darwin|win32|mac|osx|win)$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pathProperty": {
      "type": "string",
      "minLength": 1,
      "description": "Relative to this file, which is what makes it work on every machine. An absolute or ~ path works, but only where it exists; put those in .wisp.local.json.",
      "examples": [
        "apps/api",
        "README.md"
      ]
    },
    "appValue": {
      "description": "The app as this OS knows it: a name (Slack), a macOS bundle id (com.tinyspeck.slackmacgap), a command on PATH (code), or one per OS.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/perOS"
        }
      ],
      "examples": [
        "Slack",
        {
          "macos": "Visual Studio Code",
          "linux": "code",
          "windows": "code"
        }
      ]
    },
    "commandProperties": {
      "label": {
        "$ref": "#/$defs/label"
      },
      "run": {
        "description": "Passed to the shell, so pipes and && work as they read. One per OS when they differ.",
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/perOS"
          }
        ],
        "examples": [
          "pnpm dev",
          "docker compose up"
        ]
      },
      "cwd": {
        "type": "string",
        "description": "Where to run it, relative to this file.",
        "examples": [
          "apps/api"
        ]
      },
      "background": {
        "type": "boolean",
        "description": "Always run it in the background, even when you have chosen to open commands in terminal windows. For anything you never need to look at. It has no effect on a command that finishes, which Wisp always waits for.",
        "default": false
      },
      "shell": {
        "type": "string",
        "enum": [
          "sh",
          "pwsh",
          "cmd"
        ],
        "description": "Which shell `run` is written for. Defaults to your own shell on macOS and Linux, PowerShell on Windows."
      },
      "env": {
        "type": "object",
        "description": "Environment variables for this command, on top of your own.",
        "propertyNames": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "examples": [
          {
            "PORT": 3000
          }
        ]
      },
      "os": {
        "$ref": "#/$defs/os"
      },
      "restart": {
        "enum": [
          "on-failure",
          "always",
          "no"
        ],
        "description": "Bring it back when it stops: \"on-failure\" after a crash, \"always\" whenever it exits. Restarts wait longer each time (up to 30s) and stop after 10 in a row. Left out: it stays stopped."
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "description": "Runs only after the reader allows this file with `wisp trust`.",
      "properties": {
        "label": {
          "$ref": "#/$defs/commandProperties/label"
        },
        "run": {
          "$ref": "#/$defs/commandProperties/run"
        },
        "finishes": {
          "type": "boolean",
          "default": false,
          "description": "Wait for it to finish, and keep its output: a build, a test, a backup. Steps that wait for it start once it has finished. Without it, the command keeps running: Wisp starts it and moves on, like a server."
        },
        "timeout": {
          "description": "For a command that finishes: if it takes longer, Wisp stops it and everything it started, and the step fails. Seconds, or text like \"30s\", \"10m\", \"1h\". Without it, Wisp waits as long as it takes.",
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*[smh]?\\s*$"
            }
          ],
          "examples": [
            "10m",
            30,
            "1h"
          ]
        },
        "cwd": {
          "$ref": "#/$defs/commandProperties/cwd"
        },
        "background": {
          "$ref": "#/$defs/commandProperties/background"
        },
        "shell": {
          "$ref": "#/$defs/commandProperties/shell"
        },
        "env": {
          "$ref": "#/$defs/commandProperties/env"
        },
        "os": {
          "$ref": "#/$defs/commandProperties/os"
        },
        "restart": {
          "$ref": "#/$defs/commandProperties/restart"
        },
        "after": {
          "$ref": "#/$defs/after"
        }
      }
    },
    "wait": {
      "description": "Seconds (5), a port (\"5432\" or \"db:5432\"), a url that must answer, or the object form with a timeout.",
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^(https?://.+|([\\w.-]+:)?\\d{1,5}|\\d+(\\.\\d+)?s)$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "host": {
              "type": "string",
              "default": "localhost"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 60,
              "description": "Seconds before giving up."
            }
          }
        }
      ],
      "examples": [
        3,
        "localhost:5432",
        "http://localhost:3000"
      ]
    },
    "step": {
      "description": "One step of a bolt: something to open or run, a wait, Docker services, or another bolt. Steps start right away unless they say what they wait for with \"after\".",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/label"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "$ref": "#/$defs/os"
            },
            "after": {
              "$ref": "#/$defs/after"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "folder"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/label"
            },
            "folder": {
              "$ref": "#/$defs/pathProperty"
            },
            "os": {
              "$ref": "#/$defs/os"
            },
            "openWith": {
              "type": "string",
              "minLength": 1,
              "description": "The app that opens it. Only in a personal workspace: a shared file does not choose anyone's editor."
            },
            "after": {
              "$ref": "#/$defs/after"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/label"
            },
            "file": {
              "$ref": "#/$defs/pathProperty"
            },
            "os": {
              "$ref": "#/$defs/os"
            },
            "openWith": {
              "type": "string",
              "minLength": 1,
              "description": "The app that opens it. Only in a personal workspace: a shared file does not choose anyone's editor."
            },
            "after": {
              "$ref": "#/$defs/after"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/label"
            },
            "app": {
              "$ref": "#/$defs/appValue"
            },
            "os": {
              "$ref": "#/$defs/os"
            },
            "after": {
              "$ref": "#/$defs/after"
            }
          }
        },
        {
          "$ref": "#/$defs/command",
          "description": "A command written inline. Waits for `wisp trust` like any other."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compose"
          ],
          "properties": {
            "compose": {
              "type": "string",
              "minLength": 1,
              "description": "A docker compose file, relative to this file. Its services are started with `up --wait` (the step is done when they are healthy), shown with their state and logs, and stopped by `wisp down`. Waits for `wisp trust`, like a command.",
              "examples": [
                "compose.yaml",
                "deployments/development/docker-compose.yml"
              ]
            },
            "services": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Only these services. All of them when left out."
            },
            "after": {
              "$ref": "#/$defs/after"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bolt"
          ],
          "description": "Runs another bolt of this file as a step: it starts when what this step waits for is done, and steps that wait for it wait for all of it. Each bolt runs once per run, however many steps run it.",
          "properties": {
            "bolt": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "after": {
              "$ref": "#/$defs/after"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wait"
          ],
          "properties": {
            "wait": {
              "$ref": "#/$defs/wait"
            },
            "after": {
              "$ref": "#/$defs/after"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        }
      ]
    },
    "bolt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "What you type to run it, so keep it short. Its slug or any whole word of it runs it: `wisp api` runs \"Work on api\". Say more in `notes`.",
          "examples": [
            "Deploy",
            "Work on api"
          ]
        },
        "notes": {
          "type": "string",
          "description": "A line on what this bolt does, shown beside it in `wisp show`, `wisp pick`, tab completion and the TUI.",
          "examples": [
            "Builds the website and deploys it to production"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "keepGoing": {
          "type": "boolean",
          "default": false,
          "description": "Carry on after a step fails: report it, and run the steps after it anyway. Without it, a failed step stops the rest."
        },
        "confirm": {
          "description": "Ask before it runs, for a bolt with consequences: a deploy, a restore. The question to ask, or true for \"Run <label>?\". Bolts that run it ask too. Without a terminal, it runs only with --yes.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "examples": [
                "Deploy to production?"
              ]
            },
            {
              "type": "boolean"
            }
          ]
        },
        "inputs": {
          "type": "object",
          "description": "Values it asks for when it runs, used in its steps as {{name}}: in a command, its folder and environment, a link, a folder or file, a wait for a website, and confirm. A value is plain words: letters, digits, spaces and . _ - / : @ + = , ~, with no word starting with -, so it can't run commands or pass options of its own. At a terminal Wisp asks; a script passes --input name=value, or the default is used. Kept with the run in history, so not for secrets.",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ask": {
                "type": "string",
                "description": "The question, like \"Deploy where?\". Left out, the name is asked."
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?!-)[\\p{L}\\p{N}._/:@+=,~-]+(?: +(?!-)[\\p{L}\\p{N}._/:@+=,~-]+)*$"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "description": "The values to pick from."
              },
              "default": {
                "description": "Used when no value is given, and offered first at a terminal.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?!-)[\\p{L}\\p{N}._/:@+=,~-]+(?: +(?!-)[\\p{L}\\p{N}._/:@+=,~-]+)*$"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "examples": [
            {
              "env": {
                "ask": "Deploy where?",
                "choices": [
                  "staging",
                  "production"
                ],
                "default": "staging"
              }
            }
          ]
        },
        "targets": {
          "type": "array",
          "description": "What this bolt starts, in the order it starts it.",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "down": {
          "type": "array",
          "description": "Run by `wisp down` after it has stopped what this bolt started: teardown that is not a process, like `docker compose stop`.",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "after": {
      "description": "The labels of the steps of this bolt this one waits for; it starts once they have all finished. Left out, it starts right away.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      ]
    }
  }
}
