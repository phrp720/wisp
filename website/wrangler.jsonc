// The website, served by a Cloudflare Worker from its static assets: no server code.
// The "Deploy website" workflow builds it and deploys it; so does `pnpm website:deploy`
// from the repository's root.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wisp-website",
  "compatibility_date": "2026-11-01",
  // Served at the domain itself; Cloudflare makes the DNS record and certificate.
  "routes": [{ "pattern": "willowisp.dev", "custom_domain": true }],
  "assets": {
    "directory": ".vitepress/dist",
    // /docs/trust serves docs/trust.html; a missing page gets the site's own 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
