{
  "name": "wisp-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @squaredasher/wisp build",
    "test": "pnpm --filter @squaredasher/wisp test",
    "typecheck": "pnpm --filter @squaredasher/wisp typecheck",
    "spec": "pnpm --filter @squaredasher/wisp spec",
    "compile": "pnpm --filter @squaredasher/wisp compile",
    "website:dev": "pnpm --filter wisp-website dev",
    "website:build": "pnpm --filter wisp-website build",
    "website:deploy": "pnpm --filter wisp-website deploy"
  }
}
